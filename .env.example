DATABASE_URL=postgres://localhost:5432/gold_cockpit_dev
TEST_DATABASE_URL=postgres://localhost:5432/gold_cockpit_test

# Shared AI tier (S9) — server-side Anthropic key used only when the admin
# activates the "shared" provider. The per-user daily analysis limit is set by
# the admin in Settings → Users (default 3).
SHARED_AI_API_KEY=

# SerpAPI key — server-owned evidence for every provider. Optional.
# Compact analysis without evidence returns insufficient_evidence.
SERPAPI_API_KEY=

# Rollout stays v2 until benchmarks and Flutter compatibility are approved.
ANALYST_CONTRACT_VERSION=v2

# Set to 1 (or true) behind a reverse proxy that terminates HTTPS: the session
# cookie is then marked Secure and login rate limiting sees real client addresses.
# TRUST_PROXY=1
