DATABASE_URL=postgres://localhost:5432/gold_cockpit_dev
TEST_DATABASE_URL=postgres://localhost:5432/gold_cockpit_test

# Shared AI tier (S9) — server-side Anthropic key used only when a user
# activates the "shared" provider. Optional: SHARED_AI_DAILY_LIMIT (default 2).
SHARED_AI_API_KEY=
SHARED_AI_DAILY_LIMIT=2

# SerpAPI key — used to give the local Ollama provider live web-search
# context (Ollama has no native search tool). Optional: analysis just runs
# without search context if unset.
SERPAPI_API_KEY=bdee08770dfe596c27721a4c7004503efcd00c3a
