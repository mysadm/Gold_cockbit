{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analyst_output.personalized.schema.json",
  "$comment": "Deliberately self-contained rather than $ref/allOf-extending analyst_output.schema.json: that schema is additionalProperties:false, so an allOf composition would reject the added 'dca_read' field regardless of unevaluatedProperties (a real bug caught while adding the schema/validator agreement test — see NOTES). It is also what both Claude's native structured-output mode and OpenAI's strict json_schema mode require (no external $ref, no allOf+$ref, no unevaluatedProperties) — keep the two files' shared fields in sync by hand; the agreement test in tests/server/analyst-output-schema-agreement.test.mjs fails if they drift. 'dca_read' matches the only DCA output that exists today (shared/analystContract.mjs's optional reads.dca prose, rendered client-side as a ClaimField) — see NOTES 'Phase 1 fix — DCA verdict shape' for the approved proposal.",
  "title": "Gold Cockpit analyst output (personalized tier, adds DCA verdict)",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "confidence", "headline", "data_flags", "evidence", "scenario_weights", "weight_changes", "action", "next_trigger", "invalidation", "dca_read"],
  "properties": {
    "status": { "type": "string", "enum": ["material_change", "no_material_change", "insufficient_evidence"] },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "headline": { "type": "string", "minLength": 1, "maxLength": 120 },
    "data_flags": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "evidence": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ev_id", "implication"],
        "properties": {
          "ev_id": { "type": "string", "pattern": "^EV-\\d{8}-\\d{4}-\\d{2}$" },
          "implication": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "scenario_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deesc", "base", "stag"],
      "properties": {
        "deesc": { "type": "number", "minimum": 0, "maximum": 100 },
        "base": { "type": "number", "minimum": 0, "maximum": 100 },
        "stag": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "weight_changes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario", "ev_ids", "reason"],
        "properties": {
          "scenario": { "type": "string", "enum": ["deesc", "base", "stag"] },
          "ev_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^EV-\\d{8}-\\d{4}-\\d{2}$" }
          },
          "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "action": { "type": "string", "enum": ["buy", "hold", "wait", "reduce", "review", "insufficient_evidence"] },
    "next_trigger": { "type": "string", "minLength": 1, "maxLength": 200 },
    "invalidation": { "type": "string", "minLength": 1, "maxLength": 200 },
    "dca_read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "ev_ids"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "ev_ids": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string", "pattern": "^EV-\\d{8}-\\d{4}-\\d{2}$" }
        }
      }
    }
  }
}
